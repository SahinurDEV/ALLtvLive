# Google AdSense publisher ID (starts with "ca-pub-").
# Sign up at https://www.google.com/adsense/, get approved, and paste your
# client ID here. Ads render only when this variable is set.
# Then replace the placeholder slot IDs in app/page.tsx (see <AdSlot slot="..." />)
# with your real ad-unit slot IDs from AdSense.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# MongoDB Atlas connection string for storing featured channels + admin state.
# The URI must contain credentials with readWrite on the target database.
MONGODB_URI=
# Database name inside your cluster (e.g. "toto").
MONGODB_DB=toto

# Password for the /admin dashboard. Server-side only — never expose as NEXT_PUBLIC_.
ADMIN_PASSWORD=change-me

# Long random string used to sign admin session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: require a 6-digit authenticator code at admin sign-in.
# Base32 secret, e.g. from: node -e "const a='ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';let s='';for(const b of require('crypto').randomBytes(20))s+=a[b%32];console.log(s)"
# Add it to Google Authenticator / 1Password as a TOTP key.
ADMIN_TOTP_SECRET=

# Optional: salt for hashing voter IPs (defaults to SESSION_SECRET).
IP_HASH_SALT=

# Public site URL used for canonical links, robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=https://alltvlive.vercel.app
