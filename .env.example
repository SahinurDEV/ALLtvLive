# Google AdSense publisher ID (starts with "ca-pub-").
# Sign up at https://www.google.com/adsense/, get approved, and paste your
# client ID here. Ads render only when this variable is set.
# Then replace the placeholder slot IDs in app/page.tsx (see <AdSlot slot="..." />)
# with your real ad-unit slot IDs from AdSense.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
